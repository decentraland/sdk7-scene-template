{
  "$schema": "https://raw.githubusercontent.com/getcursor/cursor-config/main/schema/cursor.schema.json",
  "context": {
    "include": [
      "https://github.com/decentraland/sdk-skills"
    ],
    "exclude": [
      "**/__tests__/**",
      "**/*.test.*",
      "**/*.spec.*"
    ]
  },
  "metadata": {
    "name": "dcl-cursorai-template",
    "description": "A starter context setup for Cursor AI to use the official Decentraland SDK Skills.",
    "version": "1.1.0",
    "tags": ["decentraland", "cursor", "sdk7", "ai-context", "skills"],
    "authors": ["@drkrillo", "@decentraland"]
  }
}
